---
import Layout from '../../layouts/Layout.astro';
import SellerCatalog from '../../components/SellerCatalog';
import { supabase } from '../../lib/supabase';

export const prerender = false;

const { slug } = Astro.params;

// Fetch seller — only if catalog is active
const { data: seller } = await supabase
  .from('sellers')
  .select('*')
  .eq('slug', slug)
  .eq('is_active', true)
  .single();

if (!seller) {
  return new Response(null, { status: 302, headers: { Location: '/404' } });
}

// Fetch products with category name via join
const { data: products } = await supabase
  .from('products')
  .select('*, categories(name)')
  .eq('seller_id', seller.id)
  .order('created_at', { ascending: false });

const allProducts = products || [];

// Novedades: IDs de productos agregados en los últimos 7 días
const sevenDaysAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
const newProductIds = allProducts
  .filter((p) => p.created_at && new Date(p.created_at) >= sevenDaysAgo)
  .map((p) => p.id);

// Más vendidos: top 20% de ventas en los últimos 30 días (sin tope máximo)
const thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
let bestSellerIds: string[] = [];
if (allProducts.length > 0) {
  const { data: recentOrders } = await supabase
    .from('orders')
    .select('id')
    .eq('seller_id', seller.id)
    .gte('created_at', thirtyDaysAgo.toISOString());

  const orderIds = (recentOrders || []).map((o) => o.id);

  if (orderIds.length > 0) {
    const { data: recentItems } = await supabase
      .from('order_items')
      .select('product_id, quantity')
      .in('order_id', orderIds);

    const salesByProduct = (recentItems || []).reduce<Record<string, number>>(
      (acc, item) => {
        acc[item.product_id] = (acc[item.product_id] || 0) + item.quantity;
        return acc;
      },
      {}
    );

    const badgeCount = Math.ceil(allProducts.length * 0.2);

    bestSellerIds = Object.entries(salesByProduct)
      .sort(([, a], [, b]) => b - a)
      .slice(0, badgeCount)
      .map(([id]) => id);
  }
}

// Get unique categories used by this seller
const categoryIds = [...new Set(allProducts.map(p => p.category_id).filter((id): id is string => id !== null && id !== undefined))];

let categories: { id: string, name: string }[] = [];
if (categoryIds.length > 0) {
  const { data: cats } = await supabase
    .from('categories')
    .select('id, name')
    .in('id', categoryIds)
    .order('name');
  categories = cats || [];
}
---
<Layout title={seller.name} description={`Catálogo de productos de ${seller.name}`}>
  <SellerCatalog
    sellerName={seller.name}
    sellerId={seller.id}
    whatsappUrl={seller.whatsapp_url || ''}
    bannerUrl={seller.banner_url}
    country={seller.country || 'Honduras'}
    products={allProducts}
    newProductIds={newProductIds}
    bestSellerIds={bestSellerIds}
    categories={categories}
    client:load
  />
</Layout>

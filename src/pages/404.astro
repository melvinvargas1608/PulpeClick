---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <div class="flex flex-col items-center justify-center min-h-[80dvh] px-4 text-center">
    <a href="/" class="inline-block mb-6" aria-label="PulpeClick — Volver al inicio">
      <img src="/logo-512.png" alt="PulpeClick" class="h-20 w-auto mx-auto" />
    </a>
    <h1 class="text-2xl font-bold text-gray-900 mb-2">Página no encontrada</h1>
    <p class="text-gray-500 max-w-sm">
      La página que buscás no existe o fue movida.
    </p>
  </div>
</Layout>

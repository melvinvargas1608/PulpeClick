---
import Layout from '../../layouts/Layout.astro';
import { createSessionToken } from '../../lib/auth';

const ADMIN_PIN = import.meta.env.ADMIN_PIN || 'Admin123!';
let error = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const pin = formData.get('pin')?.toString() || '';
    
    if (pin === ADMIN_PIN) {
      const sessionToken = createSessionToken();
      return new Response(null, {
        status: 302,
        headers: {
          'Location': '/admin',
          'Set-Cookie': `admin_session=${sessionToken}; Path=/admin; HttpOnly; SameSite=Lax; Max-Age=${60 * 60 * 24}`,
        },
      });
    }
    
    error = 'PIN incorrecto';
  } catch {
    error = 'Error al verificar';
  }
}
---

<Layout title="Admin Login">
  <div class="min-h-[80dvh] flex items-center justify-center px-4">
    <div class="w-full max-w-sm">
      <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
        <h1 class="text-xl font-bold text-center text-gray-900 mb-2">
          🔐 Panel Admin
        </h1>
        <p class="text-sm text-gray-500 text-center mb-6">
          Ingresá el PIN para acceder
        </p>
        
        {error && (
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl text-sm text-center mb-4">
            {error}
          </div>
        )}
        
        <form method="POST" class="space-y-4">
          <input
            type="password"
            name="pin"
            maxlength="32"
            class="w-full text-center text-xl tracking-wider py-4 px-4 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand focus:border-brand outline-none"
            placeholder="••••••••"
            autofocus
            required
          />
          <button
            type="submit"
            class="w-full bg-brand hover:bg-brand-dark text-white font-semibold py-3 rounded-xl transition-colors"
          >
            Ingresar
          </button>
        </form>

        <p class="text-xs text-gray-400 text-center mt-4">
          El PIN debe tener más de 8 caracteres, una mayúscula, un número y un carácter especial.
        </p>
      </div>
    </div>
  </div>
</Layout>

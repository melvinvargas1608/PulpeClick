---
import Layout from '../layouts/Layout.astro';
---
<Layout title="PulpeClick">
  <div class="flex flex-col items-center justify-center min-h-[80dvh] px-4 text-center">
    <img src="/logo-512.png" alt="PulpeClick" class="h-24 w-auto mb-6" />
    <p class="text-lg text-gray-600 mb-6 max-w-sm">
      Catálogos digitales para emprendedores. Vendé más sin estar pegado al celular.
    </p>
    <a href="/admin" class="bg-brand hover:bg-brand-dark text-white font-semibold py-3 px-8 rounded-full transition-colors shadow-lg shadow-brand/20">
      Panel Admin
    </a>
  </div>
</Layout>
